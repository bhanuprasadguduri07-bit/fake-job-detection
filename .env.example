# Flask Secret Key for Session Security
SECRET_KEY=replace-with-a-random-secure-secret-key

# Database Configuration
DATABASE_PATH=instance/database.db

# Search Engine API Configuration (Optional: Enables automated discovery of company websites)
# For Google Custom Search:
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Or Bing Web Search:
BING_SEARCH_API_KEY=

# SMTP Email Configuration (Optional: Enables automated email notifications for vacancies)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
SMTP_SENDER_EMAIL=your-email@example.com

# Monitoring Settings
MONITORING_INTERVAL_HOURS=24

